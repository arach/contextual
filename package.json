{
  "name": "contextual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Contextual — context engineering as a first-class UX surface. Hangar direction on HudsonKit chrome.",
  "workspaces": [
    "../studio",
    "../hudson/packages/web/hudsonkit"
  ],
  "scripts": {
    "dev": "node scripts/ensure-hudsonkit-styles.mjs && next dev --port 5180",
    "dev:vite": "node scripts/ensure-hudsonkit-styles.mjs && vite",
    "build": "node scripts/ensure-hudsonkit-styles.mjs && next build",
    "build:vite": "node scripts/ensure-hudsonkit-styles.mjs && tsc -b && vite build",
    "start": "next start --port 5180",
    "typecheck": "tsc --noEmit",
    "typecheck:vite": "tsc -b --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "hudsonkit": "workspace:*",
    "lucide-react": "^0.574.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "studio": "link:../studio",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
